// Social Media Post Platform
app
  tabbar
    tab "Home" icon=home -> home
    tab "Search" icon=search -> search
    tab "Notifications" icon=notifications -> notifications
    tab "Messages" icon=mail -> messages
    tab "Profile" icon=person -> profile

---

view home label="Home Feed"
  Navbar "Home"

  Post "Just launched our new design system! 🎨 Check out the components we've been working on for the past 3 months." author="Sarah Chen" avatar verified time="2h" image=tech likes="234" comments="45" reposts="12"

  Divider

  Post "Breaking: New AI model achieves 95% accuracy on complex reasoning tasks. This could change everything we know about machine learning." author="Tech Daily" avatar verified time="4h" likes="1.2K" comments="189" reposts="67"

  Divider

  Post "Morning coffee thoughts ☕️\n\nSometimes the best code is the code you delete. Simplicity > Complexity" author="Alex Rivera" avatar time="6h" image=food likes="892" comments="34" reposts="156" liked

  Divider

  Post "New portfolio piece 🎯\n\nRedesigned the checkout flow for @QuickShop - reduced cart abandonment by 32%!" author="Design Studio" avatar verified time="8h" image=tech likes="567" comments="78" reposts="23"

  Divider

  Post "Excited to announce I'm joining @GlobalTech as Senior Product Designer! Can't wait to work with this amazing team 🚀" author="Emma Smith" avatar time="12h" likes="2.1K" comments="234" reposts="89"

  Fab "add" position=right-bottom color=blue

---

view search label="Search"
  Navbar "Search"

  Block
    TextField "Search Feed" type=search placeholder="Search posts, people, topics..."

  Block "Trending" variant=title

  List inset strong
    ListItem "Technology" subtitle="42.5K posts" after="#1" chevron link
    ListItem "Design Systems" subtitle="18.2K posts" after="#2" chevron link
    ListItem "AI & Machine Learning" subtitle="156K posts" after="#3" chevron link
    ListItem "Web Development" subtitle="89.3K posts" after="#4" chevron link
    ListItem "Product Design" subtitle="34.7K posts" after="#5" chevron link

  Block "Suggested Topics" variant=title

  Block
    Row gap=8
      Chip "React" media=logo-react outline
      Chip "TypeScript" outline
      Chip "UI/UX" outline
      Chip "Startups" outline

  Block
    Row gap=8
      Chip "Remote Work" outline
      Chip "Productivity" outline
      Chip "Coding" outline
      Chip "Innovation" outline

---

view notifications label="Notifications"
  Navbar "Notifications"

  Tabs active=0
    Tab "All"
    Tab "Mentions"

  List
    ListItem "New follower" subtitle="@johndoe started following you" after="2m"
      Avatar size=40

    ListItem "Like" subtitle="Sarah Chen liked your post" after="15m"
      Avatar size=40

    ListItem "Repost" subtitle="Tech Daily reposted your post" after="1h"
      Avatar size=40

    ListItem "Comment" subtitle="Alex Rivera: 'Great insight! 👏'" after="2h"
      Avatar size=40

    ListItem "New follower" subtitle="@designpro started following you" after="3h"
      Avatar size=40

    ListItem "Like" subtitle="Emma Smith liked your post" after="5h"
      Avatar size=40

    ListItem "Mention" subtitle="@techcorp mentioned you in a post" after="8h"
      Avatar size=40

    ListItem "Comment" subtitle="Design Studio: 'Love this approach!'" after="12h"
      Avatar size=40

---

view messages label="Messages"
  Navbar "Messages"

  Block
    TextField "Search messages" type=search placeholder="Search direct messages..."

  List
    ListItem "Sarah Chen" subtitle="Thanks for the feedback! Let's..." after="2m" chevron link -> chat
      Avatar size=48

    ListItem "Tech Daily" subtitle="Would you be interested in..." after="1h" chevron link -> chat
      Avatar size=48

    ListItem "Alex Rivera" subtitle="You: Sounds good! 👍" after="3h" chevron link -> chat
      Avatar size=48

    ListItem "Design Studio" subtitle="We'd love to collaborate..." after="5h" chevron link -> chat
      Avatar size=48

    ListItem "Emma Smith" subtitle="Congratulations on the launch!" after="1d" chevron link -> chat
      Avatar size=48

    ListItem "John Doe" subtitle="Hey! How's it going?" after="2d" chevron link -> chat
      Avatar size=48

---

view chat label="Chat"
  Navbar "Sarah Chen" backButton -> messages

  Message "Hey! Did you see the new design system I posted?" time="10:23 AM" avatar

  Message "I'd love to get your thoughts on it!" time="10:24 AM" avatar

  Message "Yes! It looks amazing 🎨" time="10:26 AM" sent color=blue

  Message "The component library is really well organized" time="10:26 AM" sent color=blue

  Message "Thanks for the feedback! Let's catch up soon?" time="10:28 AM" avatar

  Toolbar position=bottom
    Row gap=8 fill
      TextField placeholder="Type a message..." fill
      Button "Send" variant=fill color=blue

---

view profile label="Profile"
  Navbar "Profile"

  Block
    Image "city" fit=cover height=128

  Block mt=-12
    Row justify=between align=end
      Avatar size=96 border=white
      Button "Edit Profile" variant=outline

  Block
    Row gap=4 align=center
      Text "Your Name" variant=title bold
      Icon "checkmark-circle" size=20 color=blue
    Text "@yourhandle" variant=caption color=gray
    Spacer 8
    Text "Product Designer • Tech Enthusiast • Coffee Lover ☕️\n📍 San Francisco, CA"
    Spacer 8
    Row gap=16
      Stat "1,234" label="Following"
      Stat "5,678" label="Followers"

  Tabs active=0
    Tab "Posts"
    Tab "Replies"
    Tab "Media"
    Tab "Likes"

  Post "Working on something exciting! Can't wait to share it with you all soon 🚀✨" author="Your Name" avatar verified time="1d" likes="456" comments="67" reposts="23"

  Divider

  Post "Just finished reading an amazing book on design thinking. Highly recommend it to anyone in the field! 📚" author="Your Name" avatar verified time="3d" image=tech likes="789" comments="92" reposts="45"

  Divider

  Post "Grateful for this amazing community! Thank you all for the support and inspiration 💙" author="Your Name" avatar verified time="5d" likes="1.5K" comments="234" reposts="78" liked

---

view gallery label="Media Gallery"
  Navbar "Media" backButton -> profile

  Block "Your Photos & Videos" variant=title

  Grid cols=3 gap=4
    Image "city" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "tech" ratio=square fit=cover
    Image "city" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "tech" ratio=square fit=cover
