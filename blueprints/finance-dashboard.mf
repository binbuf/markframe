// Finance Dashboard

app
  tabbar
    tab "Home" icon=home -> home
    tab "History" icon=time -> transactions
    tab "Send" icon=paper-plane -> send
    tab "Cards" icon=card -> cards

---

view login noApp
  Navbar "Welcome"
  
  Spacer 64
  
  Block align=center
    IconCircle "wallet" size=80 color=blue bg=blue-100
    Spacer 24
    Text "FinanceFlow" variant=title size=3xl
    Text "Your money, simplified." variant=caption size=lg color=gray-500

  Spacer 48

  List inset strong
    TextField "Email" type=email placeholder="name@example.com"
    TextField "Password" type=password placeholder="••••••••"

  Block
    Button "Log In" large rounded -> home
    Spacer 16
    Button "Create Account" variant=outline

  Spacer 32
  Text "Forgot Password?" align=center color=blue-500

---

view home label="Dashboard"
  Navbar "Finance"
  
  // Account Balance Card
  Block
    Card bg=blue-500 color=white
      Column align=center gap=8
        Text "Total Balance" bold color=black-300
        Text "$24,562.00" size=4xl color=white
        Stat "+$1,240 (5.2%)" label="Since last month" color=green-300 labelColor=white

  // Quick Actions
  Block
    Row justify=around
      Column align=center gap=4
        Fab "paper-plane" color=blue -> send
        Text "Send" variant=caption
      Column align=center gap=4
        Fab "add" color=green
        Text "Top Up" variant=caption
      Column align=center gap=4
        Fab "qr-code" color=purple
        Text "Scan" variant=caption
      Column align=center gap=4
        Fab "ellipsis-horizontal" color=gray id=more-fab -> more-menu
        Text "More" variant=caption

  Popover id=more-menu target=more-fab
    MenuList outline
      MenuItem "Statements" media=document-text
      MenuItem "Settings" media=settings
      MenuItem "Help & Support" media=help-circle

  // Spending Graph Placeholder
  Block "Monthly Spending" variant=title
  Card
    Image "tech" alt="Spending Graph" ratio=2/1 rounded

  // Recent Transactions
  Block "Recent Transactions" variant=title
  List
    ListItem "Streamy Subscription" subtitle="Entertainment" after="-$15.99" media=film
    ListItem "SoundStream" subtitle="Music" after="-$9.99" media=musical-notes
    ListItem "Salary Deposit" subtitle="GlobalTech Inc." after="+$4,500.00" media=briefcase className="text-green-600"
    ListItem "Grocery Store" subtitle="Food & Drink" after="-$124.50" media=cart

---

view transactions label="History"
  Navbar "Transactions"

  Block
    Segmented options=[All, Income, Expense] active=0

  ListGroup "Today"
    ListItem "QuickCab Ride" subtitle="Transport" after="-$24.50" media=car
    ListItem "Star Coffee" subtitle="Coffee" after="-$5.40" media=cafe

  ListGroup "Yesterday"
    ListItem "Device Center" subtitle="Electronics" after="-$1,299.00" media=logo-apple
    ListItem "Freelance Payment" subtitle="Design Work" after="+$850.00" media=cash className="text-green-600"

  ListGroup "Last Week"
    ListItem "Electric Bill" subtitle="Utilities" after="-$145.00" media=flash
    ListItem "Gym Membership" subtitle="Health" after="-$45.00" media=barbell

---

view send label="Send Money"
  Navbar "Send Money"

  Block "Recipient" variant=title
  List inset
    TextField "Email or Phone" type=text placeholder="user@example.com"
    ListItem "Select from Contacts" chevron link icon=people

  Block "Amount" variant=title
  List inset
    TextField "Amount" type=number placeholder="$0.00" value="150.00"
  
  Block "Note" variant=title
  List inset
    TextField "Add a note" type=text placeholder="Dinner, Rent, etc."

  Spacer 32
  Block
    Button "Send $150.00" large rounded -> confirm-dialog

  Dialog "Confirm Transfer?" content="Send $150.00 to user@example.com?" id=confirm-dialog
    DialogButton "Cancel"
    DialogButton "Confirm"

---

view cards label="My Cards"
  Navbar "Cards"
  
  // Physical Card Visualization
  Block
    Card className="bg-gradient-to-r from-purple-500 to-indigo-600 text-white h-48"
      Column justify=between fill
        Row justify=between
          Text "Debit Card" color=white/80
          Icon "wifi" color=white
        Spacer 16
        Text "**** **** **** 4242" size=2xl bold mono color=white
        Row justify=between
          Column
            Text "Card Holder" color=white/60 size=xs
            Text "Namey McNamerson" bold color=white
          Column
            Text "Expires" color=white/60 size=xs
            Text "12/28" bold color=white

  Block "Card Settings" variant=title
  List inset strong outline
    ListItem "Show PIN" chevron link media=key
    ListItem "Freeze Card" media=lock-closed
      Switch
    ListItem "Online Payments" media=globe
      Switch checked
    ListItem "ATM Withdrawals" media=cash
      Switch checked
    ListItem "Spending Limits" chevron link media=stats-chart

  Block
    Button "Report Lost or Stolen" color=red variant=outline
