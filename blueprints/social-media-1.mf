// Social Media Picture Platform
app
  tabbar
    tab "Home" icon=home -> feed
    tab "Search" icon=search -> search
    tab "Reels" icon=play -> reels
    tab "Shop" icon=bag -> shop
    tab "Profile" icon=person -> profile

---

view feed label="ThePicturePlatform Feed"
  Navbar "ThePicturePlatform"

  StoryRow size=64 border=pink
    Story "Your Story" add
    Story "sarah_j"
    Story "mike_photos"
    Story "emma_art"
    Story "travel_bug"
    Story "foodie_life"

  Divider

  Post "Beautiful sunset at the beach 🌅 #sunset #beach" author="sarah_j" avatar verified time="2h" image=nature likes="1,234"
  Divider
  Post "Morning coffee vibes ☕️ #photography #coffee" author="mike_photos" avatar time="5h" image=food likes="3,567" liked
  Divider
  Post "New artwork finished! 🎨 What do you think?" author="emma_art" avatar verified time="1d" image=fashion likes="892"

---

view search label="Search & Explore"
  Navbar "Explore"

  Block p=2
    TextField "Search" type=search placeholder="Search users, tags, places..."

  Grid cols=3 gap=4
    Image "city" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "tech" ratio=square fit=cover
    Image "city" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "tech" ratio=square fit=cover
    Image "city" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover

---

view reels label="Reels"
  Navbar "Reels"

  Block className="relative h-screen bg-black"
    Image "travel" fit=cover className="h-full"

    Block className="absolute bottom-20 left-4 right-20 text-white"
      Row gap=8 align=center mb=2
        Avatar size=32
        Text "adventure_seeker" semibold
        Button "Follow" variant=outline className="text-white border-white px-4 py-1 text-sm"
      Text "Epic mountain hiking adventure! 🏔️ #hiking #nature #adventure" size=sm
      Row gap=4 mt=2
        Icon "musical-notes" size=16 color=white
        Text "Original Audio - adventure_seeker" variant=caption color=white

    Column gap=16 className="absolute bottom-32 right-4" align=center
      Column gap=4 align=center
        Icon "heart-outline" size=32 color=white
        Text "12.5K" variant=caption color=white
      Column gap=4 align=center
        Icon "chatbubble-outline" size=30 color=white
        Text "234" variant=caption color=white
      Column gap=4 align=center
        Icon "paper-plane-outline" size=30 color=white
        Text "89" variant=caption color=white
      Column gap=4 align=center
        Icon "ellipsis-horizontal" size=30 color=white
      Avatar size=32 border=white

---

view shop label="Shop"
  Navbar "Shop"

  Block p=2
    TextField "Search" type=search placeholder="Search products..."

  Block "Featured Collections" variant=title

  Block p=4
    Card "Summer Collection" subtitle="New Arrivals"
      Image "fashion" rounded
      Button "Shop Now" mt=2

  Block "Trending Products" variant=title

  List
    ListItem "Vintage Sunglasses" subtitle="$89.99" after="★ 4.8" chevron link
      Image "fashion" size=64 rounded fit=cover
    ListItem "Leather Backpack" subtitle="$129.99" after="★ 4.9" chevron link
      Image "travel" size=64 rounded fit=cover
    ListItem "Canvas Sneakers" subtitle="$64.99" after="★ 4.6" chevron link
      Image "fashion" size=64 rounded fit=cover
    ListItem "Denim Jacket" subtitle="$99.99" after="★ 4.7" chevron link
      Image "fashion" size=64 rounded fit=cover

---

view profile label="Profile"
  Navbar "your_username"
    Link "Add" navbar
    Link "Menu" navbar

  Block p=4
    Row gap=16 align=center
      Avatar size=80
      Column gap=8 fill
        Row gap=16 justify=around className="text-center"
          Stat "142" label="Posts"
          Stat "1.2K" label="Followers"
          Stat "856" label="Following"

    Spacer 12
    Text "Your Name" semibold
    Text "Digital Creator 📸" variant=caption
    Text "Living life one photo at a time ✨" variant=caption
    Text "📍 San Francisco, CA" variant=caption

    Spacer 12
    Row gap=8
      Button "Edit Profile" variant=outline fill
      Button "Share Profile" variant=outline fill

  Spacer 16

  Block borderTop
    Row borderBottom gap=0
      Button "Posts" fill className="py-3 border-b-2 border-black"
      Button "Reels" variant=clear fill className="py-3"
      Button "Tagged" variant=clear fill className="py-3"

  Grid cols=3 gap=4
    Image "nature" ratio=square fit=cover
    Image "city" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "tech" ratio=square fit=cover
    Image "nature" ratio=square fit=cover
    Image "city" ratio=square fit=cover
    Image "travel" ratio=square fit=cover
    Image "fashion" ratio=square fit=cover
    Image "food" ratio=square fit=cover
    Image "tech" ratio=square fit=cover

  Fab "add" position=right-bottom -> feed
